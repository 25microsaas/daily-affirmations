{
    "manifest_version": 3,
    "name": "Daily Affirmations",
    "short_name": "Affirmations",
    "version": "1.0.1",
    "description": "Transform your new tab with personalized affirmations and beautiful backgrounds for daily inspiration and mindful reminders",
    "icons": {
        "16": "images/icon-16.png",
        "32": "images/icon-32.png",
        "48": "images/icon-48.png",
        "128": "images/icon-128.png"
    },

    "action": {
        "default_icon": {
            "16": "images/icon-16.png",
            "32": "images/icon-32.png",
            "48": "images/icon-48.png",
            "128": "images/icon-128.png"
        },
        "default_title": "Daily Affirmations"
    },
    "chrome_url_overrides": {
        "newtab": "newtab.html"
    },
    "permissions": [
        "storage",
        "notifications",
        "alarms",
        "geolocation",
        "tabs"
    ],
    "host_permissions": [
        "https://api.unsplash.com/*",
        "https://api.openweathermap.org/*",
        "https://daily-affirmation.today/*",
        "https://www.daily-affirmation.today/*"
    ],
    "background": {
        "service_worker": "js/background-worker.js",
        "type": "module"
    },
    "offline_enabled": true,
    "content_security_policy": {
        "extension_pages": "script-src 'self'; connect-src 'self' https://*.unsplash.com https://api.unsplash.com https://api.openweathermap.org https://daily-affirmation.today https://www.daily-affirmation.today; img-src 'self' https://*.unsplash.com data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; object-src 'self'"
    },
    "web_accessible_resources": [{
        "resources": [
            "js/modules/*.js",
            "js/services/*.js",
            "js/utils/*.js",
            "fonts/*",
            "images/*",
            "css/*",
            "js/*",
            "*.js",
            "*.html"
        ],
        "matches": ["<all_urls>"]
    }]
}